# Local Development
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (Vercel)
# Next.js and FastAPI share the same domain on Vercel, so NEXT_PUBLIC_API_URL can just be /api
NEXT_PUBLIC_API_URL=/api

# Production Database (Vercel will provide this automatically if you use Vercel Postgres)
# DATABASE_URL=postgresql://user:password@host/dbname